<Window x:Class="RenderBatch.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RenderBatch · Tìm ảnh mẫu · Quy trình gọn 1.1.3" Width="1120" Height="900" MinWidth="950" MinHeight="740" Background="#F1F5F9" Closing="ClosingWindow">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="RenderBatch" FontSize="30" FontWeight="Bold"/><TextBlock Text="Xuất CapCut tuần tự bằng ảnh mẫu · Cần học ảnh trên PC trước khi chạy" Foreground="#475569" Margin="0,3,0,15"/></StackPanel>
 <StackPanel Grid.Row="1" x:Name="Configuration">
  <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Chọn CapCut.exe" Click="Exe_Click"/><TextBox x:Name="Exe" ToolTip="Đường dẫn CapCut.exe"/></DockPanel>
  <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Thư mục video" Click="Folder_Click"/><TextBox x:Name="Output" ToolTip="Quy trình gọn: chọn đúng thư mục đã thiết lập trong CapCut để xác nhận file MP4"/></DockPanel>
  <WrapPanel Margin="0,0,0,8"><CheckBox x:Name="SimpleFlow" Content="Quy trình gọn · dùng cấu hình hiện tại của CapCut (6 ảnh)" IsChecked="True" Click="ModeChanged" VerticalAlignment="Center"/><TextBlock Text="  Chờ xuất (phút, tối đa 180) " VerticalAlignment="Center"/><TextBox x:Name="Timeout" Text="180" Width="65"/></WrapPanel>
  <WrapPanel x:Name="AdvancedOptions" Visibility="Collapsed" Margin="0,0,0,8"><TextBlock Text="Độ phân giải " VerticalAlignment="Center"/><ComboBox x:Name="Resolution" Width="90" SelectedIndex="1" SelectionChanged="OptionsChanged"><ComboBoxItem Content="720p"/><ComboBoxItem Content="1080p"/><ComboBoxItem Content="4k"/></ComboBox><TextBlock Text="  FPS " VerticalAlignment="Center"/><ComboBox x:Name="Fps" Width="70" SelectedIndex="0" SelectionChanged="OptionsChanged"><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/></ComboBox><CheckBox x:Name="FolderPicker" Click="ModeChanged" Content="Chọn thư mục qua hộp Windows" IsChecked="True" VerticalAlignment="Center" Margin="15,0,0,0"/></WrapPanel>
  <WrapPanel><ComboBox x:Name="Role" Width="280" DisplayMemberPath="Label" SelectedValuePath="Id" Margin="0,0,8,6"/><Button Content="Học ảnh / điểm bấm" Click="Teach_Click"/><Button Content="Tìm ảnh, chỉ trỏ chuột" Click="Preview_Click"/><Button Content="Nhập file .txt" Click="Import_Click"/></WrapPanel>
  <TextBlock TextWrapping="Wrap" Text="Luồng gọn: đặt sẵn thư mục, MP4, độ phân giải/FPS trong CapCut; tên file phải trùng tên project. Để ô tìm kiếm đóng trước khi chạy. Mở project xong chờ 180 giây; xuất xong đóng và mở lại CapCut." Foreground="#475569" Margin="0,0,0,6"/>
  <TextBlock x:Name="AssetsStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
 </StackPanel>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
  <GroupBox Header="Tên project, mỗi dòng một tên" Margin="0,0,12,0"><TextBox x:Name="Names" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></GroupBox>
  <DataGrid Grid.Column="1" x:Name="Jobs" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Label}" Width="90"/><DataGridTextColumn Header="Chi tiết" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid>
 </Grid>
 <DockPanel Grid.Row="3" Margin="0,14,0,8"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="Start" Content="Chạy / Tiếp tục" Click="Start_Click"/><Button x:Name="Stop" Content="Dừng" Click="Stop_Click" IsEnabled="False"/></StackPanel><TextBlock x:Name="Status" Text="Học ảnh trước; thử một project ngắn" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
 <TextBox Grid.Row="4" x:Name="Log" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#0F172A" Foreground="#E2E8F0" FontFamily="Consolas"/>
 </Grid>
</Window>
